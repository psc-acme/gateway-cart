{
    "name": "psc-acme/gateway-cart",
    "description": "Package gateway-cart for psc-acme organization",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\GatewayCart\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3",
        "symfony/filesystem": "^7.0",
        "vlucas/phpdotenv": "^5.0",
        "webmozart/assert": "^1.0",
        "psr/cache": "^3.0",
        "symfony/process": "^7.0",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "stable",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}